// express-compat for alloy — the Express API you know, zero dependencies.
//
//   import { express } from './lib/express.ajs';   // (path relative to YOU)
//   const app = express();
//   app.use(express.cors());
//   app.use(express.json());
//   app.get('/hello/:name', (req, res) => res.json({ hi: req.params.name }));
//   app.listen(3000);
//
// Compatibility notes (vs real Express 4):
//   - next() / next(err) fully work; 4-arg (err, req, res, next) error
//     middleware detected via fn.length (the runtime exposes it).
//   - res.status().json() chains; res.cookie/redirect/type included.
//   - Router() + app.use('/prefix', router) with prefix stripping.
//   - No next('route'/'router'), no sub-app mount, no view engine,
//     no urlencoded() — use express.json() + JSON bodies.
//   - Async handlers: sync throws route to error middleware automatically;
//     a REJECTED async handler also routes via .then(null, next) chaining.
//     (An uncaught throw with no error middleware -> runtime 500 JSON.)
//   - Engine quirk: framework internals use method-call `this`, never
//     closed-over self names (see examples/web-todos/README).

import * as fs from 'alloy:fs';

const CTYPES = {
  ".html": "text/html; charset=utf-8",
  ".css": "text/css; charset=utf-8",
  ".js": "text/javascript; charset=utf-8",
  ".json": "application/json",
  ".txt": "text/plain; charset=utf-8",
  ".svg": "image/svg+xml",
  ".png": "image/png",
  ".ico": "image/x-icon"
};

function matchPath(pattern, path) {
  if (pattern === "*" || pattern === "/*") { return {}; }
  const rsegs = [];
  const psegs = [];
  const rp = pattern.split("/");
  const pp = path.split("?")[0].split("/");
  for (let i = 0; i < rp.length; i++) { if (rp[i] !== "") { rsegs.push(rp[i]); } }
  for (let i = 0; i < pp.length; i++) { if (pp[i] !== "") { psegs.push(pp[i]); } }
  if (rsegs.length !== psegs.length) { return null; }
  const params = {};
  for (let i = 0; i < rsegs.length; i++) {
    if (rsegs[i][0] === ":") {
      params[rsegs[i].slice(1)] = decodeURIComponent(psegs[i]);
    } else if (rsegs[i] === "*") {
      params["wild"] = decodeURIComponent(psegs[i]);
    } else if (rsegs[i] !== psegs[i]) {
      return null;
    }
  }
  return params;
}

function wrapReq(raw, params) {
  return {
    method: raw.method,
    url: raw.url,
    path: raw.path || raw.url,
    query: raw.query || {},
    params: params || {},
    headers: raw.headers || {},
    cookies: raw.cookies || {},
    body: raw.body,
    ip: raw.ip,
    protocol: raw.protocol,
    get: function (name) {
      return this.headers[name.toLowerCase()] || undefined;
    }
  };
}

function wrapRes(raw, app) {
  return {
    status: function (code) { raw.status(code); return this; },
    set: function (k, v) { raw.set(k, v); return this; },
    type: function (t) {
      raw.set("Content-Type", CTYPES[t] || t || "text/html; charset=utf-8");
      return this;
    },
    json: function (obj) { raw.json(obj); return this; },
    send: function (body) { raw.send(body); return this; },
    text: function (s) { raw.text(s); return this; },
    html: function (s) { raw.html(s); return this; },
    cookie: function (name, val, opts) {
      let c = encodeURIComponent(name) + "=" + encodeURIComponent(val) + "; Path=" + ((opts && opts.path) || "/");
      if (opts && opts.maxAge) { c = c + "; Max-Age=" + opts.maxAge; }
      if (opts && opts.httpOnly !== false) { c = c + "; HttpOnly"; }
      if (opts && opts.sameSite) { c = c + "; SameSite=" + opts.sameSite; }
      if (opts && opts.secure) { c = c + "; Secure"; }
      raw.set("Set-Cookie", c);
      return this;
    },
    redirect: function (a, b) {
      const url = b === undefined ? a : b;
      const code = b === undefined ? 302 : a;
      raw.status(code);
      raw.set("Location", url);
      raw.text("redirecting to " + url);
      return this;
    }
  };
}

function isErrorHandler(fn) {
  return fn.length === 4;
}

function makeStack() {
  const layers = [];
  return {
    push: function (method, path, fns) {
      layers.push({ method: method, path: path, fns: fns });
    },
    run: function (req, res, done) {
      let idx = 0;
      function next(err) {
        if (err !== undefined) {
          // Skip to the next 4-arg error layer.
          while (idx < layers.length) {
            const layer = layers[idx];
            idx = idx + 1;
            if (layer.fns.length === 1 && isErrorHandler(layer.fns[0])) {
              try {
                layer.fns[0](err, req, res, next);
              } catch (e2) {
                next(e2);
              }
              return;
            }
          }
          // No error layer left HERE: propagate to the parent stack when
          // mounted (done forwards err), else default 500 at the top app.
          done(err);
          return;
        }
        while (idx < layers.length) {
          const layer = layers[idx];
          idx = idx + 1;
          if (layer.fns.length === 1 && isErrorHandler(layer.fns[0])) {
            continue;
          }
          if (layer.method !== "USE" && layer.method !== req.method) {
            continue;
          }
          // USE layers (plain middleware and mounted routers alike):
          // prefix match. Route layers: exact/:param match.
          if (layer.method === "USE" && layer.path !== "/" && layer.path !== "*") {
            const base = req.path || req.url;
            if (base !== layer.path && base.slice(0, layer.path.length + 1) !== layer.path + "/") {
              continue;
            }
          } else if (layer.method !== "USE") {
            const params = matchPath(layer.path, req.path || req.url);
            if (params === null) {
              continue;
            }
            req.params = params;
          }
          // Run this layer's handler chain.
          runChain(layer.fns, 0);
          return;
        }
        done();
      }
      function runChain(fns, j) {
        if (j >= fns.length) {
          next();
          return;
        }
        function step(e) {
          if (e !== undefined) {
            next(e);
            return;
          }
          runChain(fns, j + 1);
        }
        // Middleware contract (Express 4 compatible): call next()
        // synchronously. Async ROUTE handlers may additionally return a
        // promise — a rejection routes to error middleware. (A middleware
        // that only returns a promise without calling next() stalls, same
        // as forgetting next() in Express, where the request hangs.)
        try {
          const r = fns[j](req, res, step);
          if (r !== undefined && r !== null && typeof r.then === "function") {
            r.then(null, function (e) { step(e); });
          }
        } catch (e) {
          step(e);
        }
      }
      next();
    }
  };
}

function makeApp() {
  const stack = makeStack();
  const settings = { "x-powered-by": true };
  const app = {
    set: function (k, v) { settings[k] = v; return this; },
    get: function (a, b) {
      // app.get(name) reads a setting; app.get(path, ...fns) routes.
      if (b === undefined && typeof a === "string" && a[0] !== "/") {
        return settings[a];
      }
      const args = [];
      for (let i = 1; i < arguments.length; i++) { args.push(arguments[i]); }
      stack.push("GET", a, args);
      return this;
    },
    post: function (a) {
      const args = [];
      for (let i = 1; i < arguments.length; i++) { args.push(arguments[i]); }
      stack.push("POST", a, args);
      return this;
    },
    put: function (a) {
      const args = [];
      for (let i = 1; i < arguments.length; i++) { args.push(arguments[i]); }
      stack.push("PUT", a, args);
      return this;
    },
    del: function (a) {
      const args = [];
      for (let i = 1; i < arguments.length; i++) { args.push(arguments[i]); }
      stack.push("DELETE", a, args);
      return this;
    },
    all: function (a) {
      const args = [];
      for (let i = 1; i < arguments.length; i++) { args.push(arguments[i]); }
      stack.push("ALL", a, args);
      return this;
    },
    use: function (a, b) {
      // use(fn), use(path, fn), use(path, router), use(router).
      // Fail fast on non-handlers: calling undefined is silent in this
      // engine, so a typo'd middleware would otherwise stall every request.
      let path = "/";
      let fn = a;
      if (typeof a === "string") {
        path = a;
        fn = b;
      }
      if ((typeof fn !== "function") && !(fn !== undefined && fn !== null && typeof fn.handle === "function")) {
        throw new Error("app.use() requires a middleware function or router (got " + typeof fn + ")");
      }
      if (fn !== undefined && fn !== null && typeof fn.handle === "function") {
        const router = fn;
        stack.push("USE", path, [function (req, res, next) {
          const full = req.path || req.url;
          let sub = full.slice(path.length);
          if (sub === "") { sub = "/"; }
          const saved = req.path;
          const savedParams = req.params;
          req.path = sub;
          req.params = {};
          router.handle(req, res, function (e) {
            req.path = saved;
            req.params = savedParams;
            next(e);
          });
        }]);
        // Mark as mount (prefix match even for exact path).
        // (layers store mount flag via path suffix convention below)
        return this;
      }
      stack.push("USE", path, [fn]);
      return this;
    },
    handle: function (rawReq, rawRes, done) {
      const self = this;
      const req = wrapReq(rawReq, {});
      const res = wrapRes(rawRes, self);
      if (self.get("x-powered-by") !== false) {
        res.set("X-Powered-By", "alloy");
      }
      // done(err): err set -> default 500 (no error middleware caught it);
      // unset -> plain miss -> 404.
      stack.run(req, res, done || function (e) {
        if (e !== undefined) {
          res.status(500);
          res.json({ error: "internal server error" });
          return;
        }
        res.status(404);
        res.json({ error: "not found" });
      });
    },
    listen: function (port) {
      const httpmod = require_http();
      const self = this;
      httpmod.createServer(function (rawReq, rawRes) {
        self.handle(rawReq, rawRes);
      }).listen(port);
      return this;
    }
  };
  // Flag mount layers: a USE layer whose fn closes over `router` is a mount.
  // (run() treats every USE layer as prefix-matched, so plain middleware
  // and mounts share one code path — see the layer.mount/USE branches.)
  return app;
}

// `http` must be required lazily (call time runs inside the app's module
// scope; load time may not have the importer's directory context).
function require_http() {
  return require("http");
}

// NOTE: there are no `express.json` statics (functions carry no JS-visible
// statics in this engine) — import the helpers by name:
//   import { express, Router, json, cors, statik } from './lib/express.ajs';
export function express() {
  return makeApp();
}

export function Router() {
  const stack = makeStack();
  return {
    get: function (a) {
      const args = [];
      for (let i = 1; i < arguments.length; i++) { args.push(arguments[i]); }
      stack.push("GET", a, args);
      return this;
    },
    post: function (a) {
      const args = [];
      for (let i = 1; i < arguments.length; i++) { args.push(arguments[i]); }
      stack.push("POST", a, args);
      return this;
    },
    put: function (a) {
      const args = [];
      for (let i = 1; i < arguments.length; i++) { args.push(arguments[i]); }
      stack.push("PUT", a, args);
      return this;
    },
    del: function (a) {
      const args = [];
      for (let i = 1; i < arguments.length; i++) { args.push(arguments[i]); }
      stack.push("DELETE", a, args);
      return this;
    },
    use: function (a, b) {
      let path = "/";
      let fn = a;
      if (typeof a === "string") { path = a; fn = b; }
      stack.push("USE", path, [fn]);
      return this;
    },
    handle: function (req, res, next) {
      stack.run(req, res, next || function (e) {
        // Unmounted router used directly: surface errors loudly instead of
        // dropping them (the top app normally provides the default 500).
        if (e !== undefined) { throw e; }
      });
    }
  };
}

function jsonMiddleware(req, res, next) {
  const ct = (req.headers["content-type"] || "").split(";")[0];
  if (ct !== "application/json") {
    next();
    return;
  }
  if (!req.body) {
    req.body = {};
    next();
    return;
  }
  try {
    req.body = JSON.parse(req.body);
  } catch (e) {
    res.status(400);
    res.json({ error: "invalid json" });
    return;
  }
  next();
}

function corsMiddleware(req, res, next) {
  res.set("Access-Control-Allow-Origin", "*");
  res.set("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS");
  res.set("Access-Control-Allow-Headers", "Content-Type, Authorization");
  if (req.method === "OPTIONS") {
    res.status(204);
    res.text("");
    return;
  }
  next();
}

function staticMiddleware(root) {
  return function (req, res, next) {
    if (req.method !== "GET") {
      next();
      return;
    }
    let rel = (req.path || req.url).split("?")[0];
    if (rel === "/") { rel = "/index.html"; }
    const segs = rel.split("/");
    for (let i = 0; i < segs.length; i++) {
      if (segs[i] === "..") {
        res.status(403);
        res.json({ error: "forbidden" });
        return;
      }
    }
    const full = root + rel;
    if (!fs.existsSync(full)) {
      next();
      return;
    }
    const body = fs.readFileSync(full);
    if (body.slice(0, 15) === "alloy fs error:") {
      next();
      return;
    }
    const dot = full.lastIndexOf(".");
    const ext = dot >= 0 ? full.slice(dot) : "";
    res.type(ext);
    res.send(body);
  };
}

// Factories, Express-style: cors() / json() take no options (v1) and hand
// back the middleware; statik(root) binds a directory.
export function json() {
  return jsonMiddleware;
}
export function cors() {
  return corsMiddleware;
}
export function statik(root) {
  return staticMiddleware(root);
}
