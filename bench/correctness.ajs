// both runtimes must agree on every printed value
print(0.1 + 0.2);
print(1 / 3);
print(2 ** 53);
print("5" * 2, "5" + 2);
print([3, 1, 2].sort().join(","));
print(JSON.parse('{"a":[1,2,{"b":null}]}').a[2].b);
print([1,2,3].map(x => x * 2).join("-"));
print(Math.max(1, 5, 3), Math.floor(2.7), -7 % 3, typeof undefined);
print("Hello World".replace(/o/g, "0"));
print(new Date(0).getTime());