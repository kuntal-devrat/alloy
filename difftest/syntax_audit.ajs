// ---- Arrow this binding ----
function f() {
  let self = this;
  let arrow = () => this;
  return arrow() === self;
}
let o = { v: 1, f: f };
print("arrow this in method:", o.f());
let g = function () {
  "use strict";
  let a = () => this;
  return a();
};
let o2 = { m: g };
print("arrow this plain call:", g() === undefined, "|", o2.m() === o2);
let h = function () {
  let a = () => () => this;
  return a()();
};
print("nested arrow this:", o2.m.call(o2) === o2, "|", h.call(o2) === o2);
function makeCounter() {
  let n = 0;
  return () => this === makeCounter;
}
let esc = makeCounter.call(makeCounter);
print("escaped arrow this:", esc());

// ---- Arrow arguments ----
function aargs(x, y) {
  let inner = () => arguments[0] + ":" + arguments[1] + ":" + arguments.length;
  return inner();
}
print("arrow arguments:", aargs(1, 2), "|", aargs("a"));
function aargs2(x) {
  let deep = () => () => arguments[0];
  return deep()();
}
print("nested arrow arguments:", aargs2(42));
let aargShadow = function (arguments) {
  return (() => arguments)();
};
print("shadowed arguments:", aargShadow(7));

// ---- ?? nullish coalescing ----
let n1 = null, n2 = undefined;
print("nullish:", n1 ?? "fallback", n2 ?? "fb", 0 ?? "x", "" ?? "x", false ?? "x", 3.5 ?? "x");
let oo = { a: null, b: { c: 5 } };
print("nullish chain:", oo?.a ?? oo?.b?.c ?? 99);
print("nullish no eval:", (function () { let n = 0; function bump() { n++; return null; } let r = bump() ?? bump(); return n; })());
let nn = 0;
print("nullish expr result:", (nn ?? 7), (null ?? 7), ((null ?? 0) + 1));
print("nullish mixed-parens:", (null ?? 0) || 5, 5 && (null ?? 9));

// ---- in operator ----
let obj = { a: 1 };
class P { pm() { return 1; } }
class C extends P { cm() { return 2; } }
let inst = new C();
print("in op:", "a" in obj, "b" in obj, "pm" in obj, "a" in {});
let arr = [10, 20];
print("in array:", 0 in arr, 1 in arr, 2 in arr, "map" in arr, "length" in arr);
let del = { x: 1 };
delete del.x;
print("in deleted:", "x" in del);
function inThrow(v) {
  try { return "x" in v; } catch (e) { return "throws"; }
}
print("in throws:", inThrow(null), inThrow(5), inThrow("ab"), inThrow(true));
// Proto-chain walk: own (cm on C.prototype), inherited (pm on P.prototype),
// absent, and via instance.
print("in proto:", "cm" in C.prototype, "pm" in C.prototype, "pm" in inst, "cm" in new P());

// ---- do...while ----
let i = 0, acc = [];
do { acc.push(i); i++; } while (i < 3);
print("do-while:", acc.join(","), i);
let j = 5, once = [];
do { once.push("run"); } while (j < 3);
print("do-while runs once:", once.join(","));
let k = 0, cont = [];
do { k++; if (k === 2) continue; cont.push(k); } while (k < 4);
print("do-while continue:", cont.join(","));
let b = 0;
outer: do { b++; if (b === 2) break outer; } while (b < 10);
print("do-while labeled break:", b);

// ---- object method shorthand / computed keys / spread ----
let meth = {
  x: 10,
  getX() { return this.x; },
  add(a, b) { return a + b; },
};
print("method shorthand:", meth.getX(), meth.add(2, 3));
let mk = "k";
let comp = { [mk]: 1, ["x" + "y"]: 2, [1 + 1]: 3, ["plain"]: 4 };
print("computed keys:", comp.k, comp.xy, comp["2"], comp.plain);
let base = { a: 1, b: 2 };
let spr = { ...base, c: 3, ...{ d: 4 }, ...base };
print("object spread:", spr.a, spr.b, spr.c, spr.d);
let del2 = { a: 1, b: 2, c: 3 };
delete del2.b;
print("spread skips deleted:", Object.keys({ ...del2 }).join(","));
print("spread array:", Object.keys({ ...arr }).join(","), { ...arr }["0"], { ...arr }["1"]);
print("spread string:", Object.keys({ ..."ab" }).join(","), { ..."ab" }["0"]);
print("spread null:", Object.keys({ ...null }).length, Object.keys({ ...undefined }).length);
let sprt = { z: 0, ...{ a: 1 }, y: 2, ...{ b: 3 } };
print("spread order:", Object.keys(sprt).join(","));
print("spread override:", { a: 1, ...{ a: 9 } }.a, { ...{ a: 9 }, a: 1 }.a);
let msh = { f() { return this.v; }, v: 3 };
print("method this:", msh.f());
let ash = { async f() { return 1; } };
print("async method:", typeof ash.f);

// ---- logical assignment ----
let la = 0;
la &&= 5;
print("&&= falsy:", la);
la = 3;
la &&= 5;
print("&&= truthy:", la);
let lo = 0;
lo ||= 9;
print("||= falsy:", lo);
lo = 4;
lo ||= 9;
print("||= truthy:", lo);
let ln = null;
ln ??= 7;
print("??= nullish:", ln);
ln = 1;
ln ??= 7;
print("??= non-nullish:", ln);
let lobj = { a: 0, b: null };
lobj.a &&= 1;
lobj.b ||= 2;
print("logical assign props:", lobj.a, lobj.b);
let lidx = [null, 5];
lidx[0] ??= 3;
lidx[1] ??= 3;
print("logical assign index:", lidx[0], lidx[1]);
let lexpr = null;
let r = (lexpr ||= "set");
print("logical assign result:", r, lexpr);
let cnt = 0;
function bump2() { cnt++; return 1; }
let lb = 1;
lb &&= bump2();
print("&&= short-circuit:", cnt, lb);
cnt = 0;
lb = 0;
lb &&= bump2();
print("&&= no eval on falsy:", cnt, lb);
